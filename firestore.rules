rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check ownership
    function isOwner(resource) {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Helper to check if the CURRENT user is an Admin
    function isAdmin() {
      // 1. Check Custom Claim (primary path)
      // 2. Check config/admins document (bootstrap fallback, replaces hardcoded UID)
      return request.auth.token.role == 'admin'
          || request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }

    // Band Leader: Can Create/Edit/Publish Setlists, Manage People
    function isBandLeader() {
      return isAdmin() || request.auth.token.role == 'band_leader';
    }

    // Musician: Band member — appears in picker, receives emails, performs
    function isMusician() {
      return isBandLeader() || request.auth.token.role == 'musician';
    }

    // Member: Community access — library + public setlists (no band features)
    function isMember() {
      return isMusician() || request.auth.token.role == 'member';
    }

    // Sound Engineer: Cross-cutting — can be any role, checked via custom claim
    function isSoundEngineer() {
      return request.auth.token.soundEngineer == true;
    }

    // USERS Collection
    match /users/{userId} {
      // Secure Rule: Own data, Leaders (for musician picker), or Admin
      allow read: if (isSignedIn() && request.auth.uid == userId) || isBandLeader() || isAdmin();
      allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();

      // Legacy subcollections (if needed)
      match /setlists/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Per-user per-song transposition preferences
      match /songPreferences/{fileId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // D2: Chart annotations — private per-user per-song
      match /annotations/{fileId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // User preferences (monitor pinned channels, etc.)
      match /preferences/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Notifications — user reads own, server writes
      match /notifications/{notifId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if isSignedIn() && (isAdmin() || isBandLeader()); // Server writes via admin SDK; client-side only for admin/leader
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // SETLISTS Collection (The new root collection)
    // v4.0: All setlists are public among band members — no private/public
    // distinction for access control beyond role-gating.
    match /setlists/{setlistId} {
      // 1. READ: Members (musicians+) and the setlist's owner.
      // v4.3 P10-04: restored isMember() gate. The claim-sync race that
      // forced the 0b10ecf relaxation is structurally addressed by the
      // P9/P10 drift-repair chain (sync-claims + getIdToken(true) + cookie
      // refresh fire on profile updates). Owners keep read access during
      // the brief post-creation sync window.
      allow read: if isMember() || isOwner(resource);

      // 2. CREATE: Any signed-in user, must set ownerId to self
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid;

      // 3. UPDATE: Owner, Band Leader, or Admin; ownerId is immutable
      //    except by admins (v4.4 SEC-008).
      allow update: if (isOwner(resource) || isBandLeader() || isAdmin())
                    && (isAdmin() || request.resource.data.ownerId == resource.data.ownerId);

      // 4. DELETE: Owner, Band Leader, or Admin
      allow delete: if isOwner(resource) || isBandLeader() || isAdmin();

    }
    
    // TASKS Collection
    // Read: Any signed-in user can read tasks (to see them on setlists)
    // Write: All writes go through the secure API routes using the Admin SDK
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // LIVE SESSIONS — Real-time performer position broadcasting
    // Read: Any signed-in user (musicians follow the leader)
    // Write: Only the broadcaster can write/delete their own session doc
    // Doc ID format: {setlistId}_{broadcasterId}
    match /live_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
                            && request.resource.data.broadcasterId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.broadcasterId == request.auth.uid;
    }
    
    // PUBLIC SETLISTS (Legacy)
    match /publicSetlists/{docId} {
      allow read: if true;
      allow write: if false; // Read-only archive
    }

    // LITURGICAL TEMPLATES — custom overrides for setlist templates
    // Read: Any signed-in user (wizard needs to load custom templates)
    // Write: Band leaders and admins (template editor)
    match /templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isBandLeader();
    }

    // CONGREGATION CONFIG (branding, feature flags)
    match /config/congregation {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ADMIN BOOTSTRAP CONFIG (super-admin UIDs for isAdmin() fallback)
    // Seeded via Firebase Admin SDK or console. isAdmin() reads this doc.
    // Write locked to Admin SDK only — this doc is read by isAdmin() itself,
    // so client-side writes would create a circular trust issue.
    match /config/admins {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // MONITOR CONFIGURATION
    // Read: Any signed-in user (bridge verifies auth via custom claims)
    // Write: Admins or sound engineers
    // Bridge heartbeat writes server-side via admin SDK (bypasses rules)
    match /config/monitor {
      allow read: if isSignedIn();
      allow write: if isAdmin()
                   || isSoundEngineer();
    }

    // FEATURED SETLIST CONFIGURATION
    // Read: Any signed-in user (everyone can see what's featured)
    // Write: Admins and band leaders (they set the featured setlist)
    match /config/featured {
      allow read: if isSignedIn();
      allow write: if isBandLeader();
    }

    // LIBRARY INDEX — server-only (admin SDK)
    // Sync engine, enrichment cron, and upload API all write via admin SDK.
    // No client should read/write directly.
    match /library_index/{fileId} {
      allow read, write: if false;

      // Chord data subcollection — server-only
      match /chordData/{page} {
        allow read, write: if false;
      }
    }

    // SETLIST HISTORY (audit trail) — append-only from authenticated users, admin reads
    match /setlists/{setlistId}/history/{entryId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();  // Append-only: users can log changes but never edit/delete
      allow update, delete: if false; // Immutable once written
    }

    // AUDIT LOGS — Server writes via Admin SDK, Admins read
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Server-only via admin SDK
    }

    // EMAIL DELIVERY TRACKING — server writes, leaders/admins read
    match /setlists/{setlistId}/emailEvents/{eventId} {
      allow read: if isBandLeader();
      allow write: if false; // Server-only via admin SDK + webhooks
    }

    // SONG USAGE TRACKING — server writes, members read
    match /songUsage/{fileId} {
      allow read: if isMember();
      allow write: if false; // Server-only via admin SDK

      match /events/{eventId} {
        allow read: if isMember();
        allow write: if false;
      }
    }

    // SCHEDULING ASSIGNMENTS — server writes via Admin SDK, musicians read own
    match /scheduling_assignments/{assignmentId} {
      allow read: if isSignedIn()
                  && (resource.data.musicianUid == request.auth.uid || isBandLeader());
      allow write: if false; // Server-only via Admin SDK
    }

    // MUSICIAN AVAILABILITY (blockout dates) — musicians manage own, leaders read all
    match /musician_availability/{blockoutId} {
      allow read: if isSignedIn()
                  && (resource.data.musicianUid == request.auth.uid || isBandLeader());
      allow create: if isSignedIn()
                    && request.resource.data.musicianUid == request.auth.uid;
      allow update, delete: if isSignedIn()
                            && resource.data.musicianUid == request.auth.uid;
    }

    // SCHEDULING HISTORY (analytics, append-only via Admin SDK)
    match /scheduling_history/{entryId} {
      allow read: if isBandLeader();
      allow write: if false; // Server-only via Admin SDK
    }

    // QR SIGN-IN SESSIONS — server-only via admin SDK
    // iPad creates via API, phone approves via API, iPad polls via API.
    // No direct client reads/writes needed.
    match /qr-sessions/{code} {
      allow read, write: if false;
    }

    // Bridge setup codes — server-only (Admin SDK)
    match /bridge-setup-codes/{code} {
      allow read, write: if false;
    }

    // Bridge redemption audit log — server-only (Admin SDK)
    match /bridge-redemptions/{id} {
      allow read, write: if false;
    }

    // MONITOR LIVE STATE — Firestore transport for mixer control
    // Bridge writes state via Admin SDK (bypasses rules).
    // Clients read state and write commands.
    match /monitor-live/state {
      allow read: if isSignedIn();
      allow write: if false; // Bridge writes via Admin SDK only
    }

    // Monitor commands — iPads write commands, bridge processes & deletes via Admin SDK.
    // S05: schema-check `type` against known allowlist and shape-fields by type.
    match /monitor-live/commands/pending/{commandId} {
      allow read: if false; // Bridge reads via Admin SDK
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.createdAt is number
                    && request.resource.data.type in [
                        'set_bus_master',
                        'set_send_level',
                        'set_send_on',
                        'set_matrix_fader',
                        'set_matrix_on'
                    ]
                    && (!('busIndex' in request.resource.data)     || request.resource.data.busIndex is int)
                    && (!('channelIndex' in request.resource.data) || request.resource.data.channelIndex is int)
                    && (!('matrixIndex' in request.resource.data)  || request.resource.data.matrixIndex is int)
                    && (!('value' in request.resource.data)        || request.resource.data.value is number
                                                                     || request.resource.data.value is bool);
      allow update, delete: if false; // Bridge deletes via Admin SDK
    }

    // System-wide alerts (read by all signed-in users, written by admins).
    match /system/globalAlert {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Deny-all fallback — any collection not explicitly matched above is locked.
    // Prevents new collections from being accidentally accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
