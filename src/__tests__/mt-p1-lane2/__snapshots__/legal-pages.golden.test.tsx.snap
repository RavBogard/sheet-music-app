// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`multi-tenant P1 golden: legal pages + changelog (CRC text on both hosts) > /accessibility: crc text, and brotherslazaroff renders the same bytes 1`] = `"<div class="min-h-screen bg-background text-foreground"><div class="border-b border-border/40 bg-card/30"><div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 sm:py-14"><p class="text-eyebrow mb-3">Legal</p><h1 class="text-title-large mb-2">Accessibility Statement</h1><p class="text-muted-foreground text-sm">Last updated: May 19, 2026</p></div></div><div class="max-w-2xl mx-auto px-4 sm:px-6 py-8 sm:py-12 pb-24 space-y-10"><p class="text-base leading-relaxed text-muted-foreground">Central Reform Congregation is committed to making the CRC Music web application accessible to musicians, congregants, and clergy of all abilities. We aim to meet or exceed the Web Content Accessibility Guidelines (WCAG) 2.1 Level AA across the app.</p><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">What we&#x27;re doing</h2><div class="h-px bg-border/50"></div><ul class="space-y-2 text-sm leading-relaxed text-muted-foreground list-none pl-0"><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span>Semantic HTML landmarks (<code>&lt;main&gt;</code>, <code>&lt;nav&gt;</code>, headings) on every route.</span></li><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span>Accessible names on all icon-only buttons (<code>aria-label</code>) and form fields (<code>&lt;label&gt;</code> or <code>aria-label</code>, never placeholder-as-label).</span></li><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span>WCAG 2.1 AA contrast on body text and interactive surfaces.</span></li><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span>Pinch-zoom and user-scaling preserved on mobile (no <code>maximum-scale=1</code> viewport lock).</span></li><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span>Skip-link to main content on app-shell routes.</span></li><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span>Keyboard support in Perform mode (chart navigation, transpose, metronome) and live regions for setlist mutations.</span></li><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span>Automated axe-core sweeps run as part of our cowork audit cadence.</span></li></ul></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Known limitations</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">We track open accessibility findings on every release cycle. The PDF-render surface inside Perform mode is the area where assistive-technology support is most limited today; we&#x27;re working to surface chart structure (sections, key, capo) outside the rendered image where possible.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Report a barrier</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">If you encounter a part of the app you can&#x27;t use with your assistive technology, please email <a href="mailto:music@centralreform.live" class="text-brand font-medium hover:underline underline-offset-2 transition-colors">music@centralreform.live</a>. Include the page URL and a short description; we&#x27;ll respond within a week.</p></section></div></div>"`;

exports[`multi-tenant P1 golden: legal pages + changelog (CRC text on both hosts) > /changelog: crc text, and brotherslazaroff renders the same bytes 1`] = `"<div class="max-w-2xl mx-auto px-4 py-8"><h1 class="text-2xl font-bold mb-6">Changelog</h1><div class="space-y-6"><div class="border-l-2 border-brand pl-4"><div class="flex items-baseline gap-3"><span class="text-lg font-semibold text-brand">v1.7</span><span class="text-sm text-muted-foreground">2026-03-11</span></div><p class="text-sm text-muted-foreground mt-1">Critical bug fixes — mobile sign-in redirect fallback, service worker update banner, user avatar display, key signature positioning.</p></div><div class="border-l-2 border-brand pl-4"><div class="flex items-baseline gap-3"><span class="text-lg font-semibold text-brand">v1.6</span><span class="text-sm text-muted-foreground">2026-03-11</span></div><p class="text-sm text-muted-foreground mt-1">Stability &amp; regression audit — auth &amp; CSP hardening, Firebase-only file serving, performance view overhaul, regression sweep.</p></div><div class="border-l-2 border-brand pl-4"><div class="flex items-baseline gap-3"><span class="text-lg font-semibold text-brand">v1.5</span><span class="text-sm text-muted-foreground">2026-03-10</span></div><p class="text-sm text-muted-foreground mt-1">Codebase &amp; UI/UX hardening — critical bug fixes, security &amp; API consistency, architecture cleanup, quality &amp; deps, UI/UX polish, performance &amp; monitoring.</p></div><div class="border-l-2 border-brand pl-4"><div class="flex items-baseline gap-3"><span class="text-lg font-semibold text-brand">v1.4</span><span class="text-sm text-muted-foreground">2026-03-10</span></div><p class="text-sm text-muted-foreground mt-1">Fixes &amp; library management — song rename, chart unlinking, archive restore, print gig packet fixes, PDF health scanner.</p></div><div class="border-l-2 border-brand pl-4"><div class="flex items-baseline gap-3"><span class="text-lg font-semibold text-brand">v1.3</span><span class="text-sm text-muted-foreground">2026-03-10</span></div><p class="text-sm text-muted-foreground mt-1">Bugsweep &amp; backend hardening — codebase audit, security &amp; data integrity fixes, error handling consistency, frontend robustness.</p></div><div class="border-l-2 border-brand pl-4"><div class="flex items-baseline gap-3"><span class="text-lg font-semibold text-brand">v1.2</span><span class="text-sm text-muted-foreground">2026-03-09</span></div><p class="text-sm text-muted-foreground mt-1">Library, manage &amp; monitor overhaul — archive &amp; health, manage redesign, monitor stability &amp; UX, templates relocation.</p></div><div class="border-l-2 border-brand pl-4"><div class="flex items-baseline gap-3"><span class="text-lg font-semibold text-brand">v1.1</span><span class="text-sm text-muted-foreground">2026-03-09</span></div><p class="text-sm text-muted-foreground mt-1">UI/UX hardening — touch &amp; accessibility, color contrast, component consistency, loading states, responsive polish, performance mode overhaul.</p></div><div class="border-l-2 border-brand pl-4"><div class="flex items-baseline gap-3"><span class="text-lg font-semibold text-brand">v1.0</span><span class="text-sm text-muted-foreground">2026-03-08</span></div><p class="text-sm text-muted-foreground mt-1">Full launch — QA bug sweep, missing features audit, UI/UX polish, admin console redesign, launch prep.</p></div><div class="border-l-2 border-brand pl-4"><div class="flex items-baseline gap-3"><span class="text-lg font-semibold text-brand">v0.1</span><span class="text-sm text-muted-foreground">2026-03-08</span></div><p class="text-sm text-muted-foreground mt-1">UI/UX redesign — design foundation, navigation &amp; layout, dashboard, setlist &amp; performance views, library &amp; monitor mix, polish &amp; accessibility.</p></div></div></div>"`;

exports[`multi-tenant P1 golden: legal pages + changelog (CRC text on both hosts) > /privacy: crc text, and brotherslazaroff renders the same bytes 1`] = `"<div class="min-h-screen bg-background text-foreground"><div class="border-b border-border/40 bg-card/30"><div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 sm:py-14"><p class="text-eyebrow mb-3">Legal</p><h1 class="text-title-large mb-2">Privacy Policy</h1><p class="text-muted-foreground text-sm">Last updated: February 23, 2026</p></div></div><div class="max-w-2xl mx-auto px-4 sm:px-6 py-8 sm:py-12 pb-24 space-y-10"><p class="text-base leading-relaxed text-muted-foreground">Central Reform Congregation (“CRC”, “we”, “us”, or “our”) operates the CRC Music web application (the “Service”). This page informs you of our policies regarding the collection, use, and disclosure of personal data when you use our Service.</p><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Information We Collect</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">We collect the following types of information:</p><ul class="space-y-2 text-sm leading-relaxed text-muted-foreground list-none pl-0"><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span><strong class="text-foreground">Account Information:</strong> Your name, email address, and profile photo when you create an account or sign in.</span></li><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span><strong class="text-foreground">Phone Number:</strong> If you choose to provide your phone number for SMS scheduling notifications.</span></li><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span><strong class="text-foreground">Musician Profile Data:</strong> Your instrument preference, transposition settings, and scheduling availability.</span></li><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span><strong class="text-foreground">Usage Data:</strong> Information about how you use the Service, including pages visited and features used.</span></li></ul></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">How We Use Your Information</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">We use collected information to:</p><ul class="space-y-1.5 text-sm leading-relaxed text-muted-foreground list-none pl-0"><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Provide and maintain the Service</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Send scheduling notifications via email, SMS, and push notifications</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Facilitate musician coordination and setlist management</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Improve the Service</li></ul></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">SMS / Mobile Messaging</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">If you opt in to receive SMS notifications, we will send you text messages related to your scheduling assignments, reminders, and cancellations at Central Reform Congregation.</p><div class="p-4 rounded-xl bg-brand/5 border border-brand/15"><p class="text-sm font-medium text-foreground leading-relaxed">Mobile information, including phone numbers, will not be shared with third parties for marketing or promotional purposes. Mobile information will only be shared with third parties as necessary to deliver the SMS messaging service (i.e., our SMS delivery provider, Twilio).</p></div><p class="text-sm leading-relaxed text-muted-foreground">Message frequency varies based on your scheduling activity. Message and data rates may apply. You may opt out of SMS notifications at any time through your profile settings or by replying STOP to any message.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Data Sharing</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">We do not sell, trade, or rent your personal information to third parties. We share information only in the following circumstances:</p><ul class="space-y-2 text-sm leading-relaxed text-muted-foreground list-none pl-0"><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span><strong class="text-foreground">Service Providers:</strong> We use trusted third-party services (Firebase, Resend, Twilio) to operate the Service. These providers only have access to information necessary to perform their functions.</span></li><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span><strong class="text-foreground">Within CRC:</strong> Band leaders and administrators may see your scheduling availability and contact information to coordinate services.</span></li><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span><strong class="text-foreground">Legal Requirements:</strong> We may disclose information if required by law.</span></li></ul></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Data Security</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">We use industry-standard security measures to protect your data, including encrypted connections (HTTPS), Firebase Authentication, and role-based access controls. However, no method of transmission over the Internet is 100% secure.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Data Retention</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">We retain your personal data only for as long as you maintain an account with the Service. You may request deletion of your account and associated data by contacting us.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Your Rights</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">You have the right to:</p><ul class="space-y-1.5 text-sm leading-relaxed text-muted-foreground list-none pl-0"><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Access the personal information we hold about you</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Request correction of inaccurate information</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Request deletion of your account and data</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Opt out of SMS notifications at any time</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Opt out of email notifications at any time</li></ul></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Children&#x27;s Privacy</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">The Service is not intended for use by anyone under the age of 13. We do not knowingly collect personal information from children under 13.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Changes to This Policy</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">We may update this Privacy Policy from time to time. We will notify you of any changes by posting the new Privacy Policy on this page and updating the “Last updated” date.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Contact Us</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">If you have any questions about this Privacy Policy, please contact Central Reform Congregation at <a href="mailto:music@centralreform.live" class="text-brand font-medium hover:underline underline-offset-2 transition-colors">music@centralreform.live</a>.</p></section></div></div>"`;

exports[`multi-tenant P1 golden: legal pages + changelog (CRC text on both hosts) > /sms-consent: crc text, and brotherslazaroff renders the same bytes 1`] = `"<div class="min-h-screen bg-background text-foreground"><div class="border-b border-border/40 bg-card/30"><div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 sm:py-14"><p class="text-eyebrow mb-3">Legal</p><h1 class="text-title-large mb-2">SMS Messaging Consent &amp; Opt-In</h1><p class="text-muted-foreground text-sm">Central Reform Congregation — CRC Music</p></div></div><div class="max-w-2xl mx-auto px-4 sm:px-6 py-8 sm:py-12 pb-24 space-y-10"><div class="p-5 sm:p-6 rounded-xl border border-brand/20 bg-brand/5"><h2 class="text-lg font-semibold text-foreground mb-3">How SMS Opt-In Works</h2><p class="text-sm text-muted-foreground mb-3 leading-relaxed">CRC Music musicians may opt in to receive SMS scheduling notifications by providing their phone number and enabling SMS notifications in their profile settings within the CRC Music application.</p><p class="text-sm text-muted-foreground leading-relaxed">Opt-in is <strong class="text-foreground">voluntary</strong> and <strong class="text-foreground">not required</strong> to use the CRC Music application. Musicians can use email and in-app notifications instead.</p></div><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Program Description</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">Central Reform Congregation operates the CRC Music application, which includes an optional SMS notification service for musician scheduling. When musicians opt in, they receive text messages about:</p><ul class="space-y-2 text-sm leading-relaxed text-muted-foreground list-none pl-0"><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span><strong class="text-foreground">Scheduling Assignments:</strong> Notification when you&#x27;re assigned to play at a service</span></li><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span><strong class="text-foreground">Reminders:</strong> Service reminders 48 hours before your scheduled performance</span></li><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span><strong class="text-foreground">Confirmations:</strong> Confirmation when you accept or decline an assignment</span></li><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span><strong class="text-foreground">Cancellations:</strong> Notification if a service or your assignment is cancelled</span></li><li class="flex gap-2"><span class="text-brand mt-1 shrink-0">•</span><span><strong class="text-foreground">Schedule Changes:</strong> Updates to services you&#x27;re assigned to</span></li></ul></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Consent Process</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">Musicians provide consent to receive SMS messages through the following process:</p><ol class="space-y-2 text-sm leading-relaxed text-muted-foreground list-none pl-0 counter-reset-custom"><li class="flex gap-3"><span class="w-6 h-6 rounded-full bg-brand/10 text-brand text-xs font-semibold flex items-center justify-center shrink-0">1</span><span>Sign in to the CRC Music application at <a href="https://www.centralreform.live" class="text-brand font-medium hover:underline underline-offset-2">www.centralreform.live</a></span></li><li class="flex gap-3"><span class="w-6 h-6 rounded-full bg-brand/10 text-brand text-xs font-semibold flex items-center justify-center shrink-0">2</span><span>Navigate to <strong class="text-foreground">Settings → Musician Profile → Scheduling</strong></span></li><li class="flex gap-3"><span class="w-6 h-6 rounded-full bg-brand/10 text-brand text-xs font-semibold flex items-center justify-center shrink-0">3</span><span>Enter your phone number in the Phone Number field</span></li><li class="flex gap-3"><span class="w-6 h-6 rounded-full bg-brand/10 text-brand text-xs font-semibold flex items-center justify-center shrink-0">4</span><span>Toggle the <strong class="text-foreground">SMS</strong> notification switch to ON</span></li><li class="flex gap-3"><span class="w-6 h-6 rounded-full bg-brand/10 text-brand text-xs font-semibold flex items-center justify-center shrink-0">5</span><span>Save your profile settings</span></li></ol><p class="text-sm leading-relaxed text-muted-foreground">By completing these steps, the musician affirmatively consents to receive SMS messages from CRC Music at the phone number provided.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Message Frequency</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">Message frequency varies based on how often the musician is scheduled for services. Typical musicians receive 2-8 messages per month. Messages are only sent in relation to your specific scheduling activity.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Message and Data Rates</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">Standard message and data rates may apply depending on your mobile carrier and plan. CRC does not charge for SMS messages sent through the Service.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Opt-Out</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">You may opt out of SMS messages at any time by:</p><ul class="space-y-1.5 text-sm leading-relaxed text-muted-foreground list-none pl-0"><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Replying <strong class="text-foreground">STOP</strong> to any message received from CRC Music</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Disabling the SMS toggle in your CRC Music profile settings</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Removing your phone number from your profile settings</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Contacting us at <a href="mailto:music@centralreform.live" class="text-brand font-medium hover:underline underline-offset-2">music@centralreform.live</a></li></ul><p class="text-sm leading-relaxed text-muted-foreground">After opting out, you will receive one final confirmation message. You will no longer receive SMS messages from CRC Music unless you opt in again.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Help</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">For help with SMS notifications, reply <strong class="text-foreground">HELP</strong> to any message or contact us at <a href="mailto:music@centralreform.live" class="text-brand font-medium hover:underline underline-offset-2">music@centralreform.live</a>.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Data Privacy</h2><div class="h-px bg-border/50"></div><div class="p-4 rounded-xl bg-brand/5 border border-brand/15"><p class="text-sm font-medium text-foreground leading-relaxed">Mobile information, including phone numbers, will not be shared with third parties for marketing or promotional purposes.</p></div><p class="text-sm leading-relaxed text-muted-foreground">Phone numbers are stored securely and used solely for delivering scheduling-related SMS messages through our messaging provider (Twilio). See our full<!-- --> <a class="text-brand font-medium hover:underline underline-offset-2" href="/privacy">Privacy Policy</a> for details on how we handle your data.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Contact Information</h2><div class="h-px bg-border/50"></div><div class="p-5 rounded-xl bg-card/70 backdrop-blur-sm border border-border/60 shadow-sm"><p class="text-sm text-foreground font-semibold">Central Reform Congregation</p><p class="text-sm text-muted-foreground mt-1">CRC Music Application</p><div class="h-px bg-border/40 my-3"></div><p class="text-sm text-muted-foreground">Email: <a href="mailto:music@centralreform.live" class="text-brand font-medium hover:underline underline-offset-2">music@centralreform.live</a></p><p class="text-sm text-muted-foreground mt-1">Web: <a href="https://www.centralreform.live" class="text-brand font-medium hover:underline underline-offset-2">www.centralreform.live</a></p></div></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">Related Policies</h2><div class="h-px bg-border/50"></div><div class="flex flex-col sm:flex-row gap-3"><a class="flex-1 p-4 rounded-xl border border-border/60 bg-card/50 hover:bg-card/80 hover:border-brand/30 transition-all duration-200 group" href="/privacy"><p class="text-sm font-medium text-foreground group-hover:text-brand transition-colors">Privacy Policy</p><p class="text-xs text-muted-foreground mt-0.5">How we handle your data</p></a><a class="flex-1 p-4 rounded-xl border border-border/60 bg-card/50 hover:bg-card/80 hover:border-brand/30 transition-all duration-200 group" href="/terms"><p class="text-sm font-medium text-foreground group-hover:text-brand transition-colors">Terms &amp; Conditions</p><p class="text-xs text-muted-foreground mt-0.5">Service usage terms</p></a></div></section></div></div>"`;

exports[`multi-tenant P1 golden: legal pages + changelog (CRC text on both hosts) > /terms: crc text, and brotherslazaroff renders the same bytes 1`] = `"<div class="min-h-screen bg-background text-foreground"><div class="border-b border-border/40 bg-card/30"><div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 sm:py-14"><p class="text-eyebrow mb-3">Legal</p><h1 class="text-title-large mb-2">Terms &amp; Conditions</h1><p class="text-muted-foreground text-sm">Last updated: February 23, 2026</p></div></div><div class="max-w-2xl mx-auto px-4 sm:px-6 py-8 sm:py-12 pb-24 space-y-10"><p class="text-base leading-relaxed text-muted-foreground">Welcome to CRC Music, a web application operated by Central Reform Congregation (“CRC”, “we”, “us”, or “our”). By using this Service, you agree to these Terms &amp; Conditions.</p><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">1. Acceptance of Terms</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">By accessing or using the CRC Music application, you agree to be bound by these Terms. If you do not agree to these Terms, you may not use the Service.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">2. Description of Service</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">CRC Music is a musician coordination tool for Central Reform Congregation that provides:</p><ul class="space-y-1.5 text-sm leading-relaxed text-muted-foreground list-none pl-0"><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Setlist creation and management</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Sheet music library and transposition</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Musician scheduling and assignment</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Notification services (email, SMS, push)</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Calendar synchronization</li></ul></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">3. User Accounts</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">You are responsible for maintaining the confidentiality of your account. You agree to provide accurate information when creating your account. CRC administrators manage user roles and access levels.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">4. SMS Messaging Terms</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">By opting in to SMS notifications through the Service, you agree to:</p><ul class="space-y-1.5 text-sm leading-relaxed text-muted-foreground list-none pl-0"><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Receive text messages related to your scheduling assignments at CRC</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Message types include: assignment notifications, reminders, confirmations, and cancellations</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Message frequency varies based on your scheduling activity</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Message and data rates may apply depending on your mobile carrier</li></ul><p class="text-sm leading-relaxed text-muted-foreground">You may opt out of SMS messages at any time by replying <strong class="text-foreground">STOP</strong> to any message or by disabling SMS notifications in your profile settings. For help, reply <strong class="text-foreground">HELP</strong> to any message or contact us at<!-- --> <a href="mailto:music@centralreform.live" class="text-brand font-medium hover:underline underline-offset-2">music@centralreform.live</a>.</p><div class="p-4 rounded-xl bg-brand/5 border border-brand/15"><p class="text-sm font-medium text-foreground leading-relaxed">Mobile information will not be shared with third parties for marketing or promotional purposes.</p></div></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">5. Acceptable Use</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">You agree not to:</p><ul class="space-y-1.5 text-sm leading-relaxed text-muted-foreground list-none pl-0"><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Use the Service for any unlawful purpose</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Share your account credentials with others</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Attempt to access other users&#x27; data without authorization</li><li class="flex gap-2"><span class="text-brand shrink-0">•</span>Upload malicious content or interfere with the Service&#x27;s operation</li></ul></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">6. Content</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">Sheet music and other content in the Service is managed by CRC for use in CRC services and events. Users must respect copyright and intellectual property rights.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">7. Disclaimer of Warranties</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">The Service is provided “as is” without warranties of any kind, either express or implied. CRC does not guarantee that the Service will be uninterrupted, secure, or error-free.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">8. Limitation of Liability</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">CRC shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising from your use of the Service.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">9. Changes to Terms</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">We reserve the right to modify these Terms at any time. Continued use of the Service after changes constitutes acceptance of the new Terms.</p></section><section class="space-y-4"><h2 class="text-xl font-semibold text-foreground tracking-tight">10. Contact</h2><div class="h-px bg-border/50"></div><p class="text-sm leading-relaxed text-muted-foreground">For questions about these Terms, contact Central Reform Congregation at<!-- --> <a href="mailto:music@centralreform.live" class="text-brand font-medium hover:underline underline-offset-2">music@centralreform.live</a>.</p></section></div></div>"`;
