{
  "name": "sheet-music-app",
  "version": "6.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/update-build-info.js && node scripts/copy-pdf-worker.js && next dev",
    "build": "node scripts/update-build-info.js && node scripts/copy-pdf-worker.js && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:kitchensink": "vitest run --testNamePattern=\"v50-07-04: kitchen-sink\"",
    "test:emulator": "firebase emulators:exec --only firestore,auth \"vitest run --config vitest.emulator.config.ts\"",
    "test:emulator:ci": "firebase emulators:exec --only firestore,auth \"vitest run --config vitest.emulator.config.ts --reporter=verbose\"",
    "test:ci": "vitest run && playwright test",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "check:types": "node scripts/check-types-sync.js",
    "postinstall": "node scripts/copy-pdf-worker.js"
  },
