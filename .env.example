# CentralReform.live Environment Variables
# Copy this to .env.local and fill in your values

# === Firebase Client SDK ===
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# === Firebase Admin SDK (Server-side) ===
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# === Firebase Storage (2.0 — CDN file serving) ===
# Format: {project-id}.firebasestorage.app (auto-derived if not set)
FIREBASE_STORAGE_BUCKET=

# === Google Drive (File intake) ===
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# === AI Features ===
# Gemini API key for cycle-3 NEW-3 library AI enrichment
# (Gemini 3.1 Pro Preview, via @google/genai). When unset, the AI
# enrichment subscriber is dormant — rows keep
# `enrichmentStatus: 'pending'` and never reach Gemini. Set in prod
# Vercel env to activate.
#
# NOTE: distinct from GOOGLE_GENERATIVE_AI_API_KEY (consumed by
# src/lib/gemini.ts for the legacy /api/cron/enrich path); the two
# surfaces are intentionally disjoint.
GEMINI_API_KEY=

# === Rate Limiting ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Batch chart intake ===
# Which executor processes a committed upload batch.
#   http    (default) - /api/intake/run, a Vercel function that chains to
#                       itself until the batch is done. What production uses.
#   inngest           - the opt-in durable-step path; honoured ONLY when
#                       INNGEST_EVENT_KEY is also set, so opting in on a
#                       deployment without Inngest credentials stays on http
#                       rather than failing to queue every batch.
INTAKE_EXECUTOR=
# Bearer the internal /api/intake/run route demands. Falls back to CRON_SECRET
# when unset; with NEITHER configured the route refuses every request and no
# batch is ever processed.
INTAKE_RUN_SECRET=
# Origin the run route calls itself back on. Defaults to
# VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL, then http://localhost:3000.
INTAKE_INTERNAL_BASE_URL=

# === "As performed" — reading the stream overlays' cue log (optional) ===
# Without both of these, reconcile_service refuses cleanly and writes nothing.
# OVERLAYS_HISTORY_TOKEN is SENSITIVE: never logged, never echoed into an error,
# never returned to a caller.
OVERLAYS_BASE_URL=
OVERLAYS_HISTORY_TOKEN=
