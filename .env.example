# CentralReform.live Environment Variables
# Copy this to .env.local and fill in your values

# === Firebase Client SDK ===
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# === Firebase Admin SDK (Server-side) ===
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# === Firebase Storage (2.0 — CDN file serving) ===
# Format: {project-id}.firebasestorage.app (auto-derived if not set)
FIREBASE_STORAGE_BUCKET=

# === Google Drive (File intake) ===
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# === AI Features ===
GEMINI_API_KEY=
# Anthropic API key for cycle-3 NEW-3 library AI enrichment (Sonnet).
# When unset, the AI enrichment subscriber is dormant — rows keep
# `enrichmentStatus: 'pending'` and never reach Sonnet. Set in prod
# Vercel env to activate.
ANTHROPIC_API_KEY=

# === Rate Limiting ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
