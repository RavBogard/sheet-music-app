# .env.example — every variable src/env.mjs declares, in the schema's own order.
#
# Regenerated 2026-09-19 (audit item (e)) and kept in step by
# `src/__tests__/env-coverage.test.ts`, which fails when src/ reads something
# this file does not name.
#
# Almost everything here is OPTIONAL and degrades gracefully. That is the
# reason the list exists: an unset variable rarely crashes this app, it just
# quietly stops doing one thing. Each line says which thing.
#
# Required on Vercel Production only (see `prodRequired` in src/env.mjs):
#   FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY, SESSION_ROLE_SECRET
# Required everywhere (the app will not boot without them):
#   NEXT_PUBLIC_FIREBASE_API_KEY, NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN,
#   NEXT_PUBLIC_FIREBASE_PROJECT_ID

# ─── Firebase Admin / service credentials ─────────────────────────────────────
# Whole service-account JSON, as an alternative to the CLIENT_EMAIL/PRIVATE_KEY pair.
FIREBASE_SERVICE_ACCOUNT_KEY=
# REQUIRED on Vercel Production. Unset: the Admin SDK cannot initialise and every
# server route that touches Firestore fails.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Drive/Sheets service account. Unset: Drive sync and chart intake cannot authenticate.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Same credentials as one JSON blob, read by DriveClient and firebase-storage.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_PROJECT_ID=
# Storage bucket for backups, chart bytes and public/today/<org>.json.
# Unset: today.json never emits and chart reads fail.
FIREBASE_STORAGE_BUCKET=

# ─── AI enrichment ────────────────────────────────────────────────────────────
# Unset: library enrichment is skipped; the review queue stops being fed.
GOOGLE_GENERATIVE_AI_API_KEY=
# Distinct from the above — the cycle-3 enrichment path. Unset: same effect.
GEMINI_API_KEY=

# ─── Rate limiting (Upstash Redis, either naming) ─────────────────────────────
# Unset: rate limiting degrades to allow-all. Safe, but the API is unprotected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The same URL/token under Vercel-marketplace naming; see src/lib/upstash-env.ts.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Unset: no email leaves the app at all — no band notifications, no alerts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Verifies Resend delivery webhooks. Unset: webhook posts are rejected.
RESEND_WEBHOOK_SECRET=
# Where bridge-health and today.json-staleness alerts go.
# Unset: those alerts are composed and then silently dropped.
BRIDGE_ALERT_EMAIL=

# ─── Cron and admin ───────────────────────────────────────────────────────────
# Bearer every /api/cron/* route checks. Unset: every cron 401s, which means
# today.json stops regenerating and nothing says so.
CRON_SECRET=
# Unset: no account can reach the super-admin surfaces.
SUPER_ADMIN_UID=
# REQUIRED on Vercel Production. Signs the role claim in the session cookie.
# Unset in prod: the app refuses to boot rather than trust an unsigned role.
SESSION_ROLE_SECRET=
# Harness-only admin test session. Unset: that endpoint 503s, which is correct in prod.
MCP_ADMIN_TEST_SESSION_SECRET=

# ─── Google Drive folders ─────────────────────────────────────────────────────
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Nightly backup mirror. Unset: the storage backup cron has nowhere to write.
BACKUP_BUCKET=
# Must differ from BACKUP_BUCKET and the drop folder.
CRC_BACKUP_DRIVE_FOLDER_ID=
# The drive-sync importer's drop folder. Unset: the importer is a graceful no-op.
DAVID_DRIVE_DROP_FOLDER_ID=
# Chart Inbox (2026-09-11). Takes precedence over DAVID_DRIVE_DROP_FOLDER_ID.
CHART_INBOX_DRIVE_FOLDER_ID=

# ─── Declared by the 2026-09-19 audit, item (e) ───────────────────────────────
# CORS allow-list for the Drive/library file routes, comma-separated.
# Unset: falls back to the two centralreform.live origins.
ALLOWED_ORIGINS=
# Added to the MCP dropzone's CSP connect-src.
# Unset: only storage.googleapis.com is allowed and the dropzone cannot reach its own origin.
MCP_PUBLIC_URL=
# Local Chrome binary for chart rendering in dev.
# Unset: the bundled @sparticuz/chromium is used, which is the correct prod path.
CHART_RENDER_CHROME_PATH=
# Which Overlays workspace the cue log must report.
# Unset: "crc". A mismatch refuses the reconcile rather than mixing rehearsal and production cues.
OVERLAYS_WORKSPACE=
# Overlays API base and bearer for the performed-history client.
# Unset: reconcile_service cannot read the cue log.
OVERLAYS_BASE_URL=
OVERLAYS_HISTORY_TOKEN=
# Org whose charts the public reader endpoint serves. Unset: the default org.
READER_MUSIC_ORG_ID=
# Master switch for the public reader chart endpoint. Unset: off (the endpoint 404s).
READER_PUBLIC_CHARTS_ENABLED=
# CORS allow-list for that endpoint.
READER_MUSIC_ALLOWED_ORIGINS=
# Brothers Lazaroff's own From address. Unset: the CRC address is used for both tenants,
# so a gig email arrives looking like it came from the congregation.
RESEND_FROM_EMAIL_BROSLAZ=
# Twilio, for setlist SMS. Unset: SMS degrades to a no-op and nobody is told.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Monitor-bridge service account. Unset: the bridge cannot mint its own credentials.
BRIDGE_SA_CLIENT_EMAIL=
BRIDGE_SA_PRIVATE_KEY=
BRIDGE_SA_PRIVATE_KEY_ID=

# ─── Client (NEXT_PUBLIC_*) ───────────────────────────────────────────────────
# REQUIRED everywhere — the app will not boot without these three.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
# Absolute base for links in push notifications and email.
# Unset: the production domain is hardcoded, which is wrong on a preview deploy.
NEXT_PUBLIC_BASE_URL=
# Web-push VAPID key. Unset: push enrollment silently no-ops and no device ever
# registers — the failure looks exactly like "nobody turned notifications on".
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Sentry browser DSN. Unset: no client-side error reporting.
NEXT_PUBLIC_SENTRY_DSN=
