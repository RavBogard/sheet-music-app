rules_version = '2';

// Chart objects carry their tenant in custom metadata `orgId` (stamped
// 2026-10-12; every library/ writer stamps it from P2 on). An object without
// it is crc — what a missing tenant has always meant. The browser does not
// read Storage today; every chart byte goes through /api/library/file/[id]
// (Admin SDK, unaffected by these rules).
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function po() { return signedIn() && request.auth.token.get('po', false) == true; }
    function hasM() { return signedIn() && request.auth.token.get('m', null) is map; }
    function legacyOrgs() {
      let o = request.auth.token.get('orgIds', []);
      return (o is list && o.size() > 0) ? o : ['crc'];
    }
    function legacyCode(t) {
      let r = request.auth.token.get('role', '');
      return !(t in legacyOrgs()) ? ''
        : r == 'admin' ? 'ad' : r == 'band_leader' ? 'bl'
        : r == 'musician' ? 'mu' : r == 'member' ? 'me' : r == 'pending' ? 'pe' : '';
    }
    function code(t) {
      return !signedIn() ? '' : hasM() ? request.auth.token.m.get(t, '') : legacyCode(t);
    }
    function rank(c) {
      return c == 'ad' ? 4 : c == 'bl' ? 3 : c == 'mu' ? 2 : c == 'me' ? 1 : c == 'pe' ? 0 : -1;
    }
    function atLeast(t, c) { return po() || rank(code(t)) >= rank(c); }
    // A MISSING orgId still means crc — what a missing tenant has always
    // meant, and legacy objects predate the stamping. An orgId that is
    // present but EMPTY does not: phase 9's adversarial pass pointed out that
    // a writer with `?? ''` instead of `?? undefined` would silently publish
    // another tenant's chart bytes to crc, and that Firestore refuses the
    // same value (rank -1) while Storage accepted it. An explicit empty
    // string is now no tenant, which nobody can be a member of.
    function objectOrg() {
      return resource.metadata == null || !('orgId' in resource.metadata) ? 'crc'
        : resource.metadata.orgId;
    }

    // Multi-tenant P5: shared collections. The visibility job stamps
    // metadata.visibleTo, a comma list of every tenant that may read the chart
    // (owner first). Without it the object's own tenant (objectOrg) is the
    // list, which is phase 2's rule. A member (not pending) of any listed
    // tenant reads; unrolled over the first 8 entries (rules have no loops).
    function objectVisibleTo() {
      return (resource.metadata != null
              && resource.metadata.get('visibleTo', '') is string
              && resource.metadata.get('visibleTo', '') != '')
        ? resource.metadata.visibleTo.split(',') : [objectOrg()];
    }
    function seesAt(v, i) { return v.size() > i && atLeast(v[i], 'me'); }
    function seesObject() {
      let v = objectVisibleTo();
      return seesAt(v, 0) || seesAt(v, 1) || seesAt(v, 2) || seesAt(v, 3)
        || seesAt(v, 4) || seesAt(v, 5) || seesAt(v, 6) || seesAt(v, 7);
    }

    match /library/{allPaths=**} {
      allow read: if atLeast(objectOrg(), 'me') || seesObject();
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
