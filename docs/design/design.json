  "components": [
    {
      "name": "Top Bar",
      "kind": "nav",
      "refersTo": "top-bar",
      "description": "Book-cloth bar with brand and tabs, 1024px and up. Teal under Brothers Lazaroff via --shell.",
      "html": "<header class=\"ds-topbar\"><a class=\"ds-brand\" href=\"#\">CRC</a><nav><a class=\"ds-tab ds-tab-active\" href=\"#\">Setlists</a><a class=\"ds-tab\" href=\"#\">Library</a><a class=\"ds-tab\" href=\"#\">Manage</a></nav></header>",
      "css": ".ds-topbar{display:flex;align-items:center;gap:32px;height:56px;padding:0 24px;background:var(--shell,#23356B);color:var(--shell-foreground,#fff);font-family:Assistant,sans-serif;}.ds-brand{font-weight:800;font-size:17px;letter-spacing:-0.01em;color:inherit;text-decoration:none}.ds-topbar nav{display:flex;align-self:stretch;gap:4px}.ds-tab{position:relative;display:inline-flex;align-items:center;min-height:44px;padding:0 14px;font-size:15px;font-weight:600;color:var(--shell-muted,#C9D2EA);text-decoration:none;transition:color .15s}.ds-tab:hover{color:var(--shell-foreground,#fff)}.ds-tab:focus-visible{outline:2px solid var(--shell-foreground,#fff);outline-offset:-4px}.ds-tab-active{color:var(--shell-active,#fff)}.ds-tab-active::after{content:\"\";position:absolute;left:12px;right:12px;bottom:0;height:3px;border-radius:2px 2px 0 0;background:var(--shell-active,#fff)}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one blue action per view (Perform, Edit, sign in).",
      "html": "<button class=\"ds-btn-primary\">Perform</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;min-height:44px;padding:0 20px;border:0;border-radius:8px;background:var(--primary,#2563EB);color:var(--primary-foreground,#fff);font-family:Assistant,sans-serif;font-size:15px;font-weight:700;cursor:pointer;transition:background .15s}.ds-btn-primary:hover{background:color-mix(in srgb,var(--primary,#2563EB) 90%,transparent)}.ds-btn-primary:focus-visible{outline:2px solid var(--ring,#2563EB);outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary actions such as Edit in the setlists list.",
      "html": "<button class=\"ds-btn-outline\">Edit</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border:1px solid var(--border,#E3E6EE);border-radius:8px;background:var(--card,#fff);color:var(--foreground,#18202E);font-family:Assistant,sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:background .15s}.ds-btn-outline:hover{background:var(--accent,#EAF0FE)}.ds-btn-outline:focus-visible{outline:2px solid var(--ring,#2563EB);outline-offset:2px}"
    },
    {
      "name": "Section Band",
      "kind": "custom",
      "refersTo": "section-band-green",
      "description": "Full-hue section header with running head and page range.",
      "html": "<div class=\"ds-bands\"><div class=\"ds-band ds-band-green\"><span>Kabbalat Shabbat</span><span class=\"ds-band-pages\">pp. 12–19</span></div><div class=\"ds-band ds-band-oxblood\"><span>Torah Service</span><span class=\"ds-band-pages\">pp. 30–34</span></div><div class=\"ds-band ds-band-ochre\"><span>Shacharit</span><span class=\"ds-band-pages\">pp. 40–52</span></div><div class=\"ds-band ds-band-blue\"><span>Maariv</span><span class=\"ds-band-pages\">p. 60</span></div></div>",
      "css": ".ds-band{display:flex;align-items:center;gap:12px;min-height:44px;padding:10px 16px;margin-top:16px;border-radius:6px;font-family:Assistant,sans-serif;font-size:14px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.ds-band:first-child{margin-top:0}.ds-band span:first-child{flex:1}.ds-band-pages{font-weight:700;letter-spacing:.04em;font-variant-numeric:tabular-nums lining-nums}.ds-band-green{background:var(--section-green,#1F7A6E);color:var(--section-green-foreground,#fff)}.ds-band-oxblood{background:var(--section-oxblood,#8E2E3B);color:var(--section-oxblood-foreground,#fff)}.ds-band-ochre{background:var(--section-ochre,#C58B1A);color:var(--section-ochre-foreground,#18202E)}.ds-band-blue{background:var(--section-blue,#23356B);color:var(--section-blue-foreground,#fff)}"
    },
    {
      "name": "Song Row",
      "kind": "custom",
      "refersTo": "song-row",
      "description": "White row on the hairline: title, key tag, page call, chip and a written warning.",
      "html": "<div class=\"ds-row\"><div class=\"ds-row-main\"><span class=\"ds-row-title\">Lecha Dodi</span><span class=\"ds-key\">Dm</span><span class=\"ds-folio\">p. 14</span></div><p class=\"ds-chip\">Main · PDF · Vocal Lead: Randy</p><p class=\"ds-warn\">Not saved offline</p></div>",
      "css": ".ds-row{padding:14px 16px;background:var(--card,#fff);border-bottom:1px solid var(--rule,#E3E6EE);font-family:Assistant,sans-serif;color:var(--foreground,#18202E);transition:background .15s}.ds-row:hover{background:var(--accent,#EAF0FE)}.ds-row-main{display:flex;align-items:baseline;gap:8px}.ds-row-title{flex:1;font-weight:700;font-size:1.2rem;line-height:1.375}.ds-key{display:inline-flex;align-items:center;justify-content:center;align-self:center;min-width:44px;height:32px;padding:0 8px;border:1px solid var(--border,#E3E6EE);border-radius:8px;background:var(--secondary,#EEF1F7);color:var(--secondary-foreground,#2B3445);font-weight:700;font-variant-numeric:tabular-nums}.ds-folio{width:80px;text-align:end;font-size:1.35rem;font-weight:800;line-height:1;letter-spacing:-0.02em;font-variant-numeric:tabular-nums lining-nums}.ds-chip{margin:2px 0 0;font-size:12px;font-weight:500;color:var(--muted-foreground,#556072)}.ds-warn{margin:2px 0 0;font-size:12px;font-weight:600;color:var(--warning-line,#8E2E3B)}"
    },
    {
      "name": "Setlist List Group",
      "kind": "card",
      "refersTo": "list-group",
      "description": "Paper block of setlist rows with hairline dividers under a group heading.",
      "html": "<section><h4 class=\"ds-group-h\">Upcoming</h4><div class=\"ds-group\"><div class=\"ds-lrow\"><b>Shabbat Morning</b><span>Sat Nov 7 · 24 songs · <em>22/24 charts ready</em></span></div><div class=\"ds-lrow\"><b>Friday Night</b><span>Fri Nov 6 · 18 songs</span></div></div></section>",
      "css": ".ds-group-h{margin:0 0 8px;padding:0 4px;font-family:Assistant,sans-serif;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted-foreground,#556072)}.ds-group{border:1px solid var(--rule,#E3E6EE);border-radius:10px;overflow:hidden;background:var(--card,#fff)}.ds-lrow{display:flex;flex-direction:column;justify-content:center;min-height:72px;padding:12px 16px;border-bottom:1px solid var(--rule,#E3E6EE);font-family:Assistant,sans-serif;cursor:pointer;transition:background .15s}.ds-lrow:last-child{border-bottom:0}.ds-lrow:hover{background:color-mix(in srgb,var(--accent,#EAF0FE) 50%,transparent)}.ds-lrow b{font-size:17px;font-weight:700;color:var(--foreground,#18202E)}.ds-lrow span{font-size:14px;font-weight:500;color:var(--muted-foreground,#556072);font-variant-numeric:tabular-nums}.ds-lrow em{font-style:normal;font-weight:600;color:var(--caution,#8A5A00)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Paper field with a field-stroke border, 44px.",
      "html": "<input class=\"ds-input\" placeholder=\"Search songs\">",
      "css": ".ds-input{height:44px;padding:0 12px;border:1px solid var(--input,#D5DAE5);border-radius:8px;background:var(--card,#fff);color:var(--foreground,#18202E);font-family:Assistant,sans-serif;font-size:14px;transition:border-color .15s}.ds-input:focus-visible{outline:none;border-color:var(--ring,#2563EB);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#2563EB) 30%,transparent)}"
    },
    {
      "name": "Bottom Tab Bar",
      "kind": "nav",
      "refersTo": "bottom-tab-bar",
      "description": "Paper tab bar below 1024px; the active tab carries a 3px top mark.",
      "html": "<nav class=\"ds-tabbar\"><a class=\"ds-btab ds-btab-active\" href=\"#\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M3 6h12M3 12h12M3 18h8\"/><circle cx=\"19\" cy=\"17\" r=\"2\"/><path d=\"M21 17V5\"/></svg><span>Setlist</span></a><a class=\"ds-btab\" href=\"#\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M4 4v16M9 4v16M14 4l5 16\"/></svg><span>Library</span></a></nav>",
      "css": ".ds-tabbar{display:flex;justify-content:space-around;height:64px;background:var(--card,#fff);border-top:1px solid var(--rule,#E3E6EE);font-family:Assistant,sans-serif;}.ds-btab{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-width:44px;color:var(--muted-foreground,#556072);text-decoration:none;font-size:12px;font-weight:600;transition:color .15s}.ds-btab:hover{color:var(--foreground,#18202E)}.ds-btab:focus-visible{outline:2px solid var(--ring,#2563EB);outline-offset:-4px}.ds-btab-active{color:var(--brand,#2563EB);font-weight:700}.ds-btab-active::before{content:\"\";position:absolute;top:0;left:50%;transform:translateX(-50%);width:40px;height:3px;border-radius:0 0 2px 2px;background:var(--brand,#2563EB)}"
    }
  ],
  "narrative": {
    "northStar": "The Siddur Section Rails",
    "overview": "The service reads like the book it follows. A setlist is set as a printed order: each section opens on a full-hue band carrying its running head and its page range, and every row carries its page call in large tabular numerals at the margin. Above it sits a slim book-cloth top bar with the tabs; below it, clean white paper on a cool ground, a 1px hairline grid, and one blue action. Freshness and readiness are always stated in a status line under the title.\n\nDensity is the product rule: text-first rows, no cover art, no card per row. Hierarchy comes from scale contrast, not decoration: the title and the page calls are large and heavy, the metadata is small and quiet. The world is light-first for bright rooms and desks; dark is a considered night-blue, not black, with the section hues a step deeper so the bands do not glare on a dim stage.\n\nBrothers Lazaroff runs the same world under its own cloth: forced dark, a deep teal ground and a deep teal top bar, a teal brand accent, a pale primary action, and Zilla Slab on its headings. The section bands, hairline grid, page calls and type ramp are shared. The chart viewer inside Perform is outside this system.",
    "keyCharacteristics": [
      "A book-cloth top bar (56px) with tabs at desktop; a white bottom tab bar (64px) below 1024px.",
      "Section header rows as full-hue bands: uppercase tracked running head left, \"pp. N–M\" right.",
      "Page calls right-aligned in a fixed column, 800 weight, tabular numerals.",
      "White rows on a 1px hairline, never a card per row, never zebra.",
      "One blue primary action per view.",
      "Assistant everywhere, Latin and Hebrew."
    ],
    "rules": [
      {
        "name": "The One Blue Rule",
        "body": "One filled primary button per view, in Action Blue. Every other action is outline, ghost or an icon button.",
        "section": "colors"
      },
      {
        "name": "The Bands Only Rule",
        "body": "The four section hues fill section bands and nothing else that carries meaning. A hue is a section's identity; reusing it for status or decoration breaks the reading.",
        "section": "colors"
      },
      {
        "name": "The Stated Warning Rule",
        "body": "A warning is a line of words in Warning Line or Caution, never a hue on its own and never a badge.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number that can sit in a column (page calls, counts, dates, keys, BPM) uses tabular lining numerals (`tnum`).",
        "section": "typography"
      },
      {
        "name": "The Scale Contrast Rule",
        "body": "Hierarchy is weight 800 against 500 and 1.5rem against 0.75rem. No second display face for CRC, no color-coded headings.",
        "section": "typography"
      },
      {
        "name": "The Hairline Rule",
        "body": "Rows are separated by a 1px Hairline and nothing else: no zebra, no gap, no per-row border box.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** open every setlist view with the title, a status line that states freshness and readiness, and the one blue action.",
      "**Do** head each section with a full-hue band carrying its running head and page range.",
      "**Do** put the page call last on the row in a fixed column at 800 weight and full ink.",
      "**Do** use `tnum` on every number in a column.",
      "**Do** keep every target at 44px or more.",
      "**Do** use the shared tokens (`--shell`, `--rule`, `--brand`, `--primary`) so Brothers Lazaroff re-skins without component edits."
    ],
    "donts": [
      "**Don't** put a card or a shadow on each row, and don't zebra-stripe; the hairline is the grid.",
      "**Don't** use a section hue for anything but a section band.",
      "**Don't** put a second filled primary button on a view.",
      "**Don't** carry a warning by color alone; write it.",
      "**Don't** use glass, glow, gradients or noise on refreshed surfaces.",
      "**Don't** let a CRC color, name or wordmark into the Brothers Lazaroff theme."
    ]
  }
