  "components": [
    {
      "name": "Top Bar",
      "kind": "nav",
      "refersTo": "top-bar",
      "description": "Book-cloth bar with brand and tabs, 1024px and up. Teal under Brothers Lazaroff via --shell.",
      "html": "<header class=\"ds-topbar\"><a class=\"ds-brand\" href=\"#\">CRC</a><nav><a class=\"ds-tab ds-tab-active\" href=\"#\">Setlists</a><a class=\"ds-tab\" href=\"#\">Library</a><a class=\"ds-tab\" href=\"#\">Manage</a></nav></header>",
      "css": ".ds-topbar{display:flex;align-items:center;gap:32px;height:56px;padding:0 24px;background:var(--shell,#23356B);color:var(--shell-foreground,#fff);font-family:Assistant,sans-serif;}.ds-brand{font-weight:800;font-size:17px;letter-spacing:-0.01em;color:inherit;text-decoration:none}.ds-topbar nav{display:flex;align-self:stretch;gap:4px}.ds-tab{position:relative;display:inline-flex;align-items:center;min-height:44px;padding:0 14px;font-size:15px;font-weight:600;color:var(--shell-muted,#C9D2EA);text-decoration:none;transition:color .15s}.ds-tab:hover{color:var(--shell-foreground,#fff)}.ds-tab:focus-visible{outline:2px solid var(--shell-foreground,#fff);outline-offset:-4px}.ds-tab-active{color:var(--shell-active,#fff)}.ds-tab-active::after{content:\"\";position:absolute;left:12px;right:12px;bottom:0;height:3px;border-radius:2px 2px 0 0;background:var(--shell-active,#fff)}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one blue action per view (Perform, Edit, New). In a head row it is drawn small (32px, 13px text) with a 44px hit area.",
      "html": "<button class=\"ds-btn-primary\">Perform</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;height:32px;padding:0 12px;border:0;border-radius:8px;background:var(--primary,#2563EB);color:var(--primary-foreground,#fff);font-family:Assistant,sans-serif;font-size:13px;font-weight:700;cursor:pointer;transition:background .15s}.ds-btn-primary:hover{background:color-mix(in srgb,var(--primary,#2563EB) 90%,transparent)}.ds-btn-primary:focus-visible{outline:2px solid var(--ring,#2563EB);outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary actions such as Edit in the setlists list.",
      "html": "<button class=\"ds-btn-outline\">Edit</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border:1px solid var(--border,#E3E6EE);border-radius:8px;background:var(--card,#fff);color:var(--foreground,#18202E);font-family:Assistant,sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:background .15s}.ds-btn-outline:hover{background:var(--accent,#EAF0FE)}.ds-btn-outline:focus-visible{outline:2px solid var(--ring,#2563EB);outline-offset:2px}"
    },
    {
      "name": "Section Label",
      "kind": "custom",
      "refersTo": "section-label-green",
      "description": "Option B: a thin 2px coloured underline with a small uppercase label in the hue ink and the page range, muted, at the right. No filled band. A leader's label is a 44px button; it stays a heading.",
      "html": "<div class=\"ds-secs\"><div class=\"ds-sec ds-sec-green\">Kabbalat Shabbat <span>pp. 12–19</span></div><div class=\"ds-row\">…</div><div class=\"ds-sec ds-sec-oxblood\">Torah Service <span>pp. 30–34</span></div><div class=\"ds-sec ds-sec-ochre\">Shacharit <span>pp. 40–52</span></div><div class=\"ds-sec ds-sec-blue\">Maariv <span>p. 60</span></div></div>",
      "css": ".ds-sec{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;padding:10px 16px 4px;margin-top:8px;border-bottom:2px solid var(--c);color:var(--c);font-family:Assistant,sans-serif;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.ds-sec:first-child{margin-top:0}.ds-sec span{font-weight:700;letter-spacing:.02em;text-transform:none;color:var(--muted-foreground,#556072);font-variant-numeric:tabular-nums lining-nums}.ds-sec-green{--c:var(--section-green-ink,#1F7A6E)}.ds-sec-oxblood{--c:var(--section-oxblood-ink,#8E2E3B)}.ds-sec-ochre{--c:var(--section-ochre-ink,#8F6210)}.ds-sec-blue{--c:var(--section-blue-ink,#23356B)}"
    },
    {
      "name": "Song Row",
      "kind": "custom",
      "refersTo": "song-row",
      "description": "Option B: a dense white row on the hairline (about 38px drawn, 44px hit): muted number, title, small outlined key tag, page call in book-blue; notes and warnings as a small second line.",
      "html": "<div class=\"ds-row\"><div class=\"ds-row-main\"><span class=\"ds-row-n\">6</span><span class=\"ds-row-title\">Bar’chu Walkdown</span><span class=\"ds-key\">Em</span><span class=\"ds-folio\">p. 59</span></div><p class=\"ds-note\">Keep it going into Yotzer Or</p></div>",
      "css": ".ds-row{padding:8px 16px;min-height:44px;box-sizing:border-box;background:var(--card,#fff);border-bottom:1px solid var(--rule,#E3E6EE);font-family:Assistant,sans-serif;color:var(--foreground,#18202E);transition:background .15s}.ds-row:hover{background:var(--accent,#EAF0FE)}.ds-row-main{display:flex;align-items:baseline;gap:8px}.ds-row-n{width:22px;font-size:12px;color:var(--muted-foreground,#556072);font-variant-numeric:tabular-nums}.ds-row-title{flex:1;font-weight:600;font-size:1rem;line-height:1.375}.ds-key{align-self:center;padding:0 5px;border:1px solid var(--input,#D5DAE5);border-radius:3px;font-size:12px;font-weight:700;line-height:16px;font-variant-numeric:tabular-nums}.ds-folio{width:56px;text-align:end;font-size:.85rem;font-weight:700;line-height:1;color:var(--page-call,#23356B);font-variant-numeric:tabular-nums lining-nums}.ds-note{margin:2px 0 0 30px;font-size:12px;font-weight:500;color:var(--caution,#8A5A00)}"
    },
    {
      "name": "Setlist List Group",
      "kind": "card",
      "refersTo": "list-group",
      "description": "Paper block of setlist rows (name over one meta line, 44px) with hairline dividers under a group heading.",
      "html": "<section><h4 class=\"ds-group-h\">Upcoming</h4><div class=\"ds-group\"><div class=\"ds-lrow\"><b>Shabbat Morning</b><span>Sat Nov 7 · 24 songs · <em>22/24 charts ready</em></span></div><div class=\"ds-lrow\"><b>Friday Night</b><span>Fri Nov 6 · 18 songs</span></div></div></section>",
      "css": ".ds-group-h{margin:0 0 8px;padding:0 4px;font-family:Assistant,sans-serif;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted-foreground,#556072)}.ds-group{border:1px solid var(--rule,#E3E6EE);border-radius:10px;overflow:hidden;background:var(--card,#fff)}.ds-lrow{display:flex;flex-direction:column;justify-content:center;min-height:44px;padding:4px 16px;border-bottom:1px solid var(--rule,#E3E6EE);font-family:Assistant,sans-serif;cursor:pointer;transition:background .15s}.ds-lrow:last-child{border-bottom:0}.ds-lrow:hover{background:color-mix(in srgb,var(--accent,#EAF0FE) 50%,transparent)}.ds-lrow b{font-size:.95rem;font-weight:700;color:var(--foreground,#18202E)}.ds-lrow span{font-size:12px;font-weight:500;color:var(--muted-foreground,#556072);font-variant-numeric:tabular-nums}.ds-lrow em{font-style:normal;font-weight:600;color:var(--caution,#8A5A00)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Paper field with a field-stroke border, 44px.",
      "html": "<input class=\"ds-input\" placeholder=\"Search songs\">",
      "css": ".ds-input{height:44px;padding:0 12px;border:1px solid var(--input,#D5DAE5);border-radius:8px;background:var(--card,#fff);color:var(--foreground,#18202E);font-family:Assistant,sans-serif;font-size:14px;transition:border-color .15s}.ds-input:focus-visible{outline:none;border-color:var(--ring,#2563EB);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#2563EB) 30%,transparent)}"
    },
    {
      "name": "Bottom Tab Bar",
      "kind": "nav",
      "refersTo": "bottom-tab-bar",
      "description": "Paper tab bar below 1024px; the active tab carries a 3px top mark.",
      "html": "<nav class=\"ds-tabbar\"><a class=\"ds-btab ds-btab-active\" href=\"#\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M3 6h12M3 12h12M3 18h8\"/><circle cx=\"19\" cy=\"17\" r=\"2\"/><path d=\"M21 17V5\"/></svg><span>Setlist</span></a><a class=\"ds-btab\" href=\"#\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M4 4v16M9 4v16M14 4l5 16\"/></svg><span>Library</span></a></nav>",
      "css": ".ds-tabbar{display:flex;justify-content:space-around;height:64px;background:var(--card,#fff);border-top:1px solid var(--rule,#E3E6EE);font-family:Assistant,sans-serif;}.ds-btab{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-width:44px;color:var(--muted-foreground,#556072);text-decoration:none;font-size:12px;font-weight:600;transition:color .15s}.ds-btab:hover{color:var(--foreground,#18202E)}.ds-btab:focus-visible{outline:2px solid var(--ring,#2563EB);outline-offset:-4px}.ds-btab-active{color:var(--brand,#2563EB);font-weight:700}.ds-btab-active::before{content:\"\";position:absolute;top:0;left:50%;transform:translateX(-50%);width:40px;height:3px;border-radius:0 0 2px 2px;background:var(--brand,#2563EB)}"
    }
  ],
  "narrative": {
    "northStar": "The Siddur Section Rails, quiet (Option B)",
    "overview": "The service reads like the book it follows, and nothing gets between the reader and the order. Each section opens on a thin coloured underline carrying a small uppercase label and its page range; every row carries its page call at the margin in bold book-blue at row size. Above it sits a slim book-cloth top bar with the tabs; below it, clean white paper on a cool ground, a 1px hairline grid, and one blue action. Every head is a title plus ONE meta line that states freshness and readiness.\n\nDensity is the product rule (Daniel, 2026-11-01: blend E's full-colour bands, huge page numbers and tall headers were too bloated and slowed getting to the info). Rows run about 36–40px drawn and keep 44px hit areas through padding or the touch-hit utility. Hierarchy comes from weight and a little colour, not scale: the title is 800, the page call 700 in book-blue, the metadata small and quiet. The world is light-first for bright rooms and desks; dark is a considered night-blue with lifted section inks.\n\nBrothers Lazaroff runs the same density under its own cloth: forced dark, a deep teal ground and top bar, a teal brand accent (also its page-call ink), a pale primary action, Zilla Slab on its headings, and a slate fourth section ink. The chart viewer inside Perform is outside this system.",
    "keyCharacteristics": [
      "A book-cloth top bar (56px) with tabs at desktop; a white bottom tab bar (64px) below 1024px.",
      "Section labels as a thin 2px coloured underline: small uppercase label in the hue ink left, muted \"pp. N–M\" (and set totals) right. No filled bands.",
      "Page calls right-aligned in a fixed column at row size, 700 weight, book-blue, tabular numerals.",
      "Dense white rows (about 38px drawn, 44px hit) on a 1px hairline, never a card per row, never zebra.",
      "Every head is a title (1rem/800) plus ONE meta line; the gig line, parasha and Beit Mitzvah are single small lines.",
      "One blue primary action per view, drawn small in a head row.",
      "Assistant everywhere, Latin and Hebrew."
    ],
    "rules": [
      {
        "name": "The One Blue Rule",
        "body": "One filled primary button per view, in Action Blue. Every other action is outline, ghost or an icon button.",
        "section": "colors"
      },
      {
        "name": "The Section Ink Rule",
        "body": "The four section inks draw section labels and their underline and nothing else that carries meaning. A hue is a section's identity; reusing it for status or decoration breaks the reading.",
        "section": "colors"
      },
      {
        "name": "The Stated Warning Rule",
        "body": "A warning is a line of words in Warning Line or Caution, never a hue on its own and never a badge.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number that can sit in a column (page calls, counts, dates, keys, BPM) uses tabular lining numerals (`tnum`).",
        "section": "typography"
      },
      {
        "name": "The Quiet Hierarchy Rule",
        "body": "Hierarchy is weight (800 titles, 700 page calls, 500 metadata) and a small step in size (1rem against 0.75rem), never large numerals or tall heads. No second display face for CRC.",
        "section": "typography"
      },
      {
        "name": "The Hairline Rule",
        "body": "Rows are separated by a 1px Hairline and nothing else: no zebra, no gap, no per-row border box.",
        "section": "elevation"
      },
      {
        "name": "The One Meta Line Rule",
        "body": "A head is a title and ONE meta line under it, with the primary action on the right. Status, book, date and readiness share that line, separated by dots; nothing gets its own tall block.",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** open every view with the title, ONE meta line that states freshness and readiness, and the one blue action.",
      "**Do** head each section with a thin coloured underline carrying its label and page range.",
      "**Do** put the page call last on the row in a fixed column, bold, in book-blue at row size.",
      "**Do** keep rows dense (about 36–40px drawn) and every target at 44px through padding or touch-hit.",
      "**Do** use `tnum` on every number in a column.",
      "**Do** use the shared tokens (`--shell`, `--rule`, `--brand`, `--primary`, `--section-*-ink`, `--page-call`) so Brothers Lazaroff re-skins without component edits."
    ],
    "donts": [
      "**Don't** fill a section with its hue, or set page numbers in large numerals; both were retired on 2026-11-01.",
      "**Don't** stack a status line, a book line and a card under a title; fold them into the one meta line.",
      "**Don't** put a card or a shadow on each row, and don't zebra-stripe; the hairline is the grid.",
      "**Don't** use a section ink for anything but a section label.",
      "**Don't** put a second filled primary button on a view.",
      "**Don't** carry a warning by color alone; write it.",
      "**Don't** let a CRC color, name or wordmark into the Brothers Lazaroff theme."
    ]
  }
