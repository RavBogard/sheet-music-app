{
  "name": "centralreform-bridge",
  "version": "2.4.0",
  "description": "CentralReform X32 Monitor Bridge — connects iPads to the Behringer X32 via OSC",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "electron dist/main.js",
    "dev": "tsc && electron dist/main.js",
    "build-exe": "tsc && npx @electron/packager . \"CentralReform Bridge\" --platform=win32 --arch=x64 --out=release --overwrite"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.0.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/selfsigned": "^2.0.4",
    "@types/ws": "^8.18.1",
    "@yao-pkg/pkg": "^5.11.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}