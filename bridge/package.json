{
  "name": "centralreform-bridge",
  "version": "2.4.0",
  "description": "CentralReform X32 Monitor Bridge — connects iPads to the Behringer X32 via OSC",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build-exe": "tsc && pkg dist/launcher.js --target node20-win-x64 --output dist/CentralReform-Bridge.exe --compress GZip",
    "install-service": "node scripts/install-service.js",
    "uninstall-service": "node scripts/uninstall-service.js"
  },
  "pkg": {
    "assets": [
      "dist/**/*.js"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.0.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/selfsigned": "^2.0.4",
    "@types/ws": "^8.18.1",
    "@yao-pkg/pkg": "^5.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}