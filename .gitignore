# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (harness output — dirtied by every run; never commit)
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# per-worktree-git-identity-enforcement (see scripts/setup-coord-worktree.sh):
# this marker is set per-worktree by the setup script and read by the
# pre-commit hook to enforce coder-N@coord.local attribution. NEVER commit
# it — it would ship one coder's id across all branches and defeat the
# per-worktree contract.
.coord/.worktree-coder

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# log files
*.log

# bridge server
bridge/node_modules/
bridge/dist/
bridge/.env
bridge/service-account-key.json
bridge/certs/
bridge/bridge-config.json

# PDF.js worker — copied from node_modules by postinstall/build
public/pdf.worker.min.mjs
public/pdf.worker.min.*.mjs

# public/sw.js is now a hand-written tombstone (2026-05-17) — committed,
# not gitignored. See next.config.ts for context.
public/workbox-*.js
public/workbox-*.js.map
certs/
bridge/release/
.env*.local
